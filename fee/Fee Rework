  <script>
    // ============================ Sticky Nav ============================
    const navbar = document.getElementById("navbar");
    const burger = document.getElementById("burgerBtn");
    const menu = document.getElementById("navMenu");

    let lastScrollY = window.scrollY;

    function updateNav() {
      if (window.scrollY > 100) {
        navbar.classList.add("is-stuck");
      } else {
        navbar.classList.remove("is-stuck");
      }
    }

    window.addEventListener("scroll", updateNav);
    updateNav();

    burger.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("is-open");
      burger.setAttribute("aria-expanded", isOpen);
    });

    // ============================ Reveal on Scroll ============================
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll(".reveal-on-scroll").forEach(el => observer.observe(el));

    // ============================ Fee Dropdown Interactions ============================
    const feeDropdowns = document.querySelectorAll(".fee-dropdown");
    const feeItems = document.querySelectorAll(".fee-dropdown-item");

    feeDropdowns.forEach((dd, idx) => {
      const toggle = dd.querySelector(".fee-dropdown-toggle");
      toggle.addEventListener("click", () => {
        dd.toggleAttribute("open");
        feeDropdowns.forEach((other) => {
          if (other !== dd) other.removeAttribute("open");
        });
      });

      dd.querySelectorAll(".fee-dropdown-item").forEach((item, i) => {
        item.addEventListener("click", () => {
          const parent = item.closest(".fee-dropdown");
          parent.querySelectorAll(".fee-dropdown-item").forEach((other) => {
            other.classList.remove("is-selected");
          });
          item.classList.add("is-selected");
        });
      });
    });

    // ============================ Form Handling ============================
    function handleForm(event) {
      event.preventDefault();
      const toast = document.getElementById("formToast");
      toast.classList.add("is-shown");
      setTimeout(() => toast.classList.remove("is-shown"), 5000);
      event.target.reset();
      return false;
    }

    // ============================ Seal hover interaction ============================
    const seal = document.querySelector(".seal-stage");
    seal.addEventListener("mouseenter", () => {
      seal.style.transition = "transform 0.4s cubic-bezier(.16,1,.3,1)";
      seal.style.transform = "scale(1.02) rotate(1deg)";
    });
    seal.addEventListener("mouseleave", () => {
      seal.style.transform = "scale(1) rotate(0deg)";
    });

    // ============================ Stagger animation for cards ============================
    const cards = document.querySelectorAll(".mv-card");
    cards.forEach((card, i) => {
      setTimeout(() => {
        card.style.opacity = "1";
        card.style.transform = "translateY(0)";
      }, i * 100);
    });

    // ============================ Fee Navigation ============================
    const feeNav = document.getElementById("feeNav");
    const feeButtons = feeNav.querySelectorAll(".btn");

    feeButtons.forEach(button => {
      button.addEventListener("click", () => {
        feeButtons.forEach(btn => btn.classList.remove("is-active"));
        button.classList.add("is-active");
      });
    });

  </script>
