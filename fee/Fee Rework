<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fees Structure — DPS Millennium International School</title>
  <meta name="description" content="Official fee structure for DPS Millennium International School, Al Wukair, Qatar. Annual fees by year group.">
  <link rel="icon" href="../homepage/assets/shield.svg">
  <style>
  /* =========================================================
    FONTS
  ========================================================= */

  @font-face {
    font-family: "Plex Sans";
    src: url("../homepage/assets/fonts/plex-sans-400.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Plex Sans";
    src: url("../homepage/assets/fonts/plex-sans-500.woff2") format("woff2");
    font-weight: 500;
    font-display: swap;
  }

  @font-face {
    font-family: "Plex Sans";
    src: url("../homepage/assets/fonts/plex-sans-600.woff2") format("woff2");
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: "Plex Serif";
    src: url("../homepage/assets/fonts/plex-serif-400.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Plex Serif";
    src: url("../homepage/assets/fonts/plex-serif-600.woff2") format("woff2");
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: "Plex Arabic";
    src: url("../homepage/assets/fonts/plex-arabic-400.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }


  /* =========================================================
    VARIABLES
  ========================================================= */

  :root {
    --paper: #F3EEE4;
    --paper-2: #EAE2D3;
    --paper-card: #FAF6EF;

    --ink: #17061F;
    --ink-2: #240C30;
    --ink-card: #20082B;

    --purple: #400068;
    --purple-lift: #54008A;
    --purple-glow: rgba(84, 0, 138, 0.35);

    --green: #1E5A33;
    --green-soft: #277744;

    --gold: #D8A800;
    --gold-lift: #E6B509;
    --gold-glow: rgba(216, 168, 0, 0.3);
    --gold-faint: rgba(216, 168, 0, 0.12);

    --q-gold: #D8A800;
    --q-red: #D82818;
    --q-indigo: #382898;
    --q-purple: #400068;

    --rule: rgba(23, 6, 31, 0.14);
    --rule-strong: rgba(23, 6, 31, 0.28);
    --rule-ink: rgba(243, 238, 228, 0.16);

    --muted: #5E4C6B;
    --muted-ink: #C5B5D0;

    --shadow-sm: 0 4px 16px rgba(23, 6, 31, 0.06);
    --shadow-md: 0 16px 36px -10px rgba(23, 6, 31, 0.14);
    --shadow-ink: 0 20px 45px -12px rgba(0, 0, 0, 0.55);
    --shadow-gold: 0 0 30px rgba(216, 168, 0, 0.22);

    --gutter: clamp(1.25rem, 5vw, 4.5rem);
    --sec: clamp(4.5rem, 10vh, 8rem);

    --r: 16px;
    --r-sm: 10px;
    --r-pill: 9999px;
  }


  /* =========================================================
    RESET
  ========================================================= */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
    scrollbar-color: rgba(64, 0, 104, 0.3) var(--paper);
    font-size: clamp(16px, 4px + 0.625vw, 20px);
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Plex Sans", system-ui, sans-serif;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    caret-color: var(--purple);
    accent-color: var(--purple);
  }

  img,
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }

  p,
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  summary {
    font-family: inherit;
  }

  ::selection {
    background: var(--gold);
    color: var(--ink);
  }

  :where(a, button, input, summary, details):focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }


  /* =========================================================
    SCROLLBAR
  ========================================================= */

  ::-webkit-scrollbar {
    width: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--paper);
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(64, 0, 104, 0.35);
    border: 3px solid var(--paper);
    border-radius: 9999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--purple);
  }


  /* =========================================================
    GENERAL LAYOUT
  ========================================================= */

  .wrap {
    max-inline-size: 82rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }


  /* =========================================================
    HEADINGS
  ========================================================= */

  .h {
    font-family: "Plex Sans", system-ui, sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.024em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .h--xl {
    font-size: clamp(2.3rem, 1.2rem + 4.8vw, 4.75rem);
  }

  .h--lg {
    font-size: clamp(1.85rem, 1.2rem + 2.8vw, 3.25rem);
  }

  .h--md {
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .h--sm {
    font-size: clamp(1.05rem, 0.98rem + 0.3vw, 1.25rem);
    letter-spacing: -0.01em;
  }


  /* =========================================================
    EYEBROW
  ========================================================= */

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;

    color: var(--gold);
    margin-block-end: 1rem;
  }

  .eyebrow::before {
    content: "";
    width: 1.25rem;
    height: 2px;
    background: currentColor;
  }


  /* =========================================================
    BUTTONS
  ========================================================= */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;

    background: var(--purple);
    color: var(--paper);

    font-weight: 500;
    font-size: 0.9375rem;

    padding: 0.85rem 1.7rem;

    border: 1px solid transparent;
    border-radius: 9999px;

    font-family: inherit;
    cursor: pointer;

    position: relative;
    overflow: hidden;

    transition:
      all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn:hover {
    background: var(--purple-lift);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--purple-glow);
  }

  .btn--gold {
    background: var(--gold);
    color: var(--ink);
    font-weight: 600;
  }

  .btn--gold:hover {
    background: var(--gold-lift);
    box-shadow: 0 8px 25px var(--gold-glow);
  }

  /* =========================================================
     FEE CARD FOOTERS & BADGES
  ========================================================= */
  .mv-card__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .65rem;
    margin-block-start: 1.5rem !important;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
  }

  .mv-card__foot .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .5rem .85rem;
    border-radius: 999px;
    background: var(--gold-faint);
    border: 1px solid rgba(216, 168, 0, .35);
    color: var(--ink);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .02em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .mv-card__foot .badge:last-child {
    margin-inline-start: auto;
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .mv-card__foot .badge:last-child {
      margin-inline-start: 0;
      width: 100%;
    }
  }


  /* ============================ PRIMARY FEE CARD ============================ */
  .primary-fee-layout {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(2.5rem, 5vw, 4.5rem) !important;
    align-items: start;
  }

  .primary-fee-table-wrap {
    min-inline-size: 0 !important;
    padding-block: .35rem;
  }

  .primary-fee-table {
    width: 100%;
    border-collapse: separate !important;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--rule-strong) !important;
    border-radius: 14px;
    background: var(--paper-card);
    box-shadow: 0 8px 24px rgba(23, 6, 31, .05);
    font-size: .9rem !important;
  }

  .primary-fee-table thead {
    background: var(--purple) !important;
    color: var(--paper);
  }

  .primary-fee-table th {
    padding: 1rem 1.1rem !important;
    border: 0 !important;
    text-align: left;
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .primary-fee-table th:last-child,
  .primary-fee-table td:last-child {
    text-align: right;
  }

  .primary-fee-table td {
    padding: 1.05rem 1.1rem !important;
    border: 0 !important;
    border-top: 1px solid var(--rule) !important;
    color: var(--ink);
  }

  .primary-fee-table tbody tr {
    transition: background .2s ease;
  }

  .primary-fee-table tbody tr:hover {
    background: var(--gold-faint);
  }

  .primary-fee-table td:last-child {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .primary-payment-flow {
    min-inline-size: 0 !important;
    padding: 1.25rem !important;
    border-radius: 16px !important;
    background: rgba(243,238,228,.38) !important;
  }

  @media (max-width: 900px) {
    .primary-fee-layout {
      grid-template-columns: 1fr;
      gap: 2rem !important;
    }
  }

  @media (max-width: 640px) {
    .primary-fee-table {
      font-size: .82rem !important;
    }

    .primary-fee-table th,
    .primary-fee-table td {
      padding: .85rem .75rem !important;
    }
  }


  .btn--ghost {
    background: rgba(255, 255, 255, 0.05);
    color: inherit;
    border-color: rgba(243, 238, 228, 0.3);
    backdrop-filter: blur(8px);
  }

  .btn--ghost:hover {
    background: rgba(243, 238, 228, 0.15);
    border-color: var(--paper);
  }


  /* =========================================================
    TOP BAR
  ========================================================= */

  /* =========================================================
     MIDDLE & HIGH FEE TABLES
  ========================================================= */

  .fee-table {
    width: 100%;
    border-collapse: separate !important;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--rule) !important;
    border-radius: 14px;
    background: var(--paper-card);
    box-shadow: 0 8px 24px rgba(23, 6, 31, 0.06);
    font-size: .9rem !important;
  }

  .fee-table th {
    padding: 1rem 1.1rem !important;
    background: linear-gradient(135deg, var(--purple), var(--purple-lift));
    color: var(--paper) !important;
    border: 0 !important;
    font-size: .76rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .fee-table th:first-child { border-radius: 13px 0 0 0; }
  .fee-table th:last-child { border-radius: 0 13px 0 0; }

  .fee-table td {
    padding: 1rem 1.1rem !important;
    border: 0 !important;
    border-bottom: 1px solid var(--rule) !important;
    color: var(--ink) !important;
    background: transparent;
  }

  .fee-table tbody tr:last-child td { border-bottom: 0 !important; }
  .fee-table tbody tr:nth-child(even) td { background: rgba(64, 0, 104, 0.035); }
  .fee-table tbody tr:hover td { background: var(--gold-faint); }

  .fee-table td:last-child {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--purple) !important;
  }

  #middle .fee-table {
    background: var(--paper);
    border-color: rgba(243, 238, 228, .25) !important;
  }

  @media (max-width: 700px) {
    .fee-table { font-size: .82rem !important; }
    .fee-table th, .fee-table td { padding: .8rem .75rem !important; }
  }

  .topbar {
    background: #0D0312;
    color: #DCCBE8;
    font-size: 0.75rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .topbar__in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .topbar a {
    color: var(--gold);
    transition: opacity 0.2s ease;
  }

  .topbar a:hover {
    opacity: 0.85;
    text-decoration: underline;
  }

  .topbar__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    background: rgba(216, 168, 0, 0.15);
    border: 1px solid rgba(216, 168, 0, 0.3);

    padding: 0.15rem 0.55rem;
    border-radius: 99px;

    color: var(--gold);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .topbar__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
    animation: blink 1.6s infinite ease-in-out;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.4;
      transform: scale(0.7);
    }
  }


  /* =========================================================
    NAVIGATION
  ========================================================= */

  .bar {
    background: #17061F;
    color: var(--paper);

    position: sticky;
    top: 0;
    z-index: 60;

    transition: box-shadow 0.3s ease;
  }

  .bar.is-stuck {
    box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.7);
  }

  .bar__in {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    text-decoration: none;
    margin-inline-end: auto;

    color: var(--paper);
  }

  .brand img {
    width: 2rem;
  }

  .brand b {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    display: block;
  }

  .brand span {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-ink);
    font-weight: 500;
  }


  /* =========================================================
    DESKTOP MENU
  ========================================================= */

  .menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu > li {
    position: relative;
  }

  .menu > li > a {
    display: flex;
    align-items: center;
    gap: 0.4rem;

    padding: 0.9rem 0.85rem;

    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;

    white-space: nowrap;

    color: var(--paper);

    transition: color 0.2s ease;
  }

  .menu > li:hover > a,
  .menu > li:focus-within > a {
    color: var(--gold);
  }


  /* =========================================================
    CHEVRON
  ========================================================= */

  .menu > li > a .chevron {
    display: inline-block;

    width: 0.4em;
    height: 0.4em;

    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;

    transform: rotate(45deg) translateY(-0.1em);

    transition: transform 0.2s ease;
  }

  .menu > li:hover > a .chevron,
  .menu > li:focus-within > a .chevron {
    transform: rotate(225deg) translateY(-0.25em);
  }


  /* =========================================================
    DROPDOWN MENU
  ========================================================= */

  .sub {
    position: absolute;
    top: 100%;
    left: 0;

    min-width: 15rem;

    background: var(--paper);
    color: var(--ink);

    list-style: none;

    margin: 0;
    padding: 0.5rem 0;

    border-radius: 0 0 14px 14px;

    box-shadow: 0 18px 40px -12px rgba(23, 6, 31, 0.45);

    opacity: 0;
    visibility: hidden;

    transform: translateY(-6px);

    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;

    z-index: 70;
  }

  .menu > li:hover .sub,
  .menu > li:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .sub a {
    display: block;

    padding: 0.55rem 1.1rem;

    font-size: 0.875rem;

    color: var(--ink);

    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .sub a:hover {
    background: #E9E1D2;
    color: var(--purple);
  }

  .sub li.off a {
    color: var(--muted);
    pointer-events: none;
    font-size: 0.8125rem;
  }

  .sub li.off a::after {
    content: " — soon";
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }


  /* =========================================================
    NAVIGATION CTA
  ========================================================= */

  .bar__cta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .burger {
    display: none;

    background: none;
    border: 1px solid rgba(243, 238, 228, 0.2);

    color: inherit;

    border-radius: 99px;

    padding: 0.5rem 0.9rem;

    font: inherit;
    font-size: 0.8125rem;

    cursor: pointer;

    margin-inline-start: auto;
  }


  /* =========================================================
    HERO
  ========================================================= */

  .hero {
    background: #0C0413;
    color: var(--paper);

    position: relative;
    overflow: hidden;

    border-bottom: 1px solid rgba(216, 168, 0, 0.15);
  }


  /* Subtle glow */

  .hero::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        circle at 78% 50%,
        rgba(84, 0, 138, 0.16),
        transparent 35%
      ),
      radial-gradient(
        circle at 25% 55%,
        rgba(216, 168, 0, 0.05),
        transparent 35%
      );

    pointer-events: none;
  }


  /* Gold glow at bottom */

  .hero::after {
    content: "";

    position: absolute;

    left: -15%;
    bottom: -55%;

    width: 700px;
    height: 700px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(216, 168, 0, 0.08),
        transparent 65%
      );

    pointer-events: none;
  }


  /* =========================================================
    HERO LAYOUT
  ========================================================= */

  .hero__in {
    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);

    align-items: center;

    min-height: 585px;

    padding-block:
      clamp(3.5rem, 9vh, 6.5rem)
      clamp(4rem, 10vh, 7rem);

    overflow: visible;
  }


  /* =========================================================
    HERO TEXT — LEFT SIDE
  ========================================================= */

  .hero__copy {
    position: relative;
    z-index: 5;

    max-width: 580px;

    opacity: 0;

    transform: translateX(-55px);

    animation:
      heroTextIn
      1s
      cubic-bezier(0.16, 1, 0.3, 1)
      0.25s
      forwards;
  }


  /* Main heading */

  .hero__copy h1 {
    color: var(--paper);

    margin: 0;

    font-size: clamp(
      2.5rem,
      1.5rem + 4vw,
      5rem
    );

    line-height: 0.98;
  }


  /* Gold portion of heading */

  .hero__copy h1 span {
    color: var(--gold);
  }


  /* Status badge */

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    background: rgba(216, 168, 0, 0.12);

    border: 1px solid rgba(216, 168, 0, 0.3);

    padding: 0.35rem 0.95rem;

    border-radius: 9999px;

    font-size: 0.75rem;
    font-weight: 600;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--gold);

    margin-bottom: 1.5rem;
  }


  /* Small glowing dot */

  .hero__status span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--gold);

    box-shadow:
      0 0 8px var(--gold),
      0 0 15px rgba(216, 168, 0, 0.45);

    animation: statusPulse 2s ease-in-out infinite;
  }

  @keyframes statusPulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.45;
      transform: scale(0.7);
    }
  }


  /* Hero paragraph */

  .hero__sub {
    font-size: clamp(
      1.05rem,
      1rem + 0.5vw,
      1.28rem
    );

    color: #E2D4EE;

    max-width: 48ch;

    margin-top: 1.5rem;

    line-height: 1.55;
  }


  /* Hero buttons */

  .hero__cta {
    display: flex;
    flex-wrap: wrap;

    gap: 1rem;

    margin-top: 2.2rem;
  }


  /* =========================================================
    HERO TEXT STAGGER
  ========================================================= */

  .hero__copy .hero__status {
    opacity: 0;

    animation:
      fadeUp
      0.7s
      ease
      0.45s
      forwards;
  }

  .hero__copy h1 {
    opacity: 0;

    animation:
      fadeUp
      0.8s
      cubic-bezier(0.16, 1, 0.3, 1)
      0.55s
      forwards;
  }

  .hero__copy .hero__sub {
    opacity: 0;

    animation:
      fadeUp
      0.8s
      cubic-bezier(0.16, 1, 0.3, 1)
      0.7s
      forwards;
  }

  .hero__copy .hero__cta {
    opacity: 0;

    animation:
      fadeUp
      0.8s
      cubic-bezier(0.16, 1, 0.3, 1)
      0.85s
      forwards;
  }

  @keyframes heroTextIn {
    from {
      opacity: 0;
      transform: translateX(-55px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  /* =========================================================
    SEAL / LOGO AREA
  ========================================================= */

  .seal-stage {
    position: relative;

    z-index: 3;

    width: 100%;

    display: flex;

    justify-content: center;
    align-items: center;

    transform: translateX(10vw);

    animation:
      seal-sweep-right
      1s
      cubic-bezier(0.16, 1, 0.3, 1)
      0.1s
      backwards;
  }


  /* =========================================================
    SEAL HALO
  ========================================================= */

  .seal-halo {
    position: absolute;

    width: 115%;

    aspect-ratio: 1;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(216, 168, 0, 0.24) 0%,
        rgba(84, 0, 138, 0.3) 45%,
        rgba(0, 0, 0, 0) 70%
      );

    pointer-events: none;

    animation:
      haloGlow
      6s
      ease-in-out
      infinite;
  }

  @keyframes haloGlow {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.96);
    }

    50% {
      opacity: 0.65;
      transform: scale(1.04);
    }
  }


  /* =========================================================
    SEAL
  ========================================================= */

  .seal {
    position: relative;

    aspect-ratio: 1296 / 1299;

    width: 100%;

    max-width: 410px;

    margin-inline: auto;

    animation:
      sealFloat
      7s
      ease-in-out
      infinite;

    filter:
      drop-shadow(
        0 20px 40px rgba(0, 0, 0, 0.55)
      );
  }

  .seal img {
    position: absolute;

    inset: 0;

    width: 100%;
  }


  /* =========================================================
    SEAL FLOAT
  ========================================================= */

  @keyframes sealFloat {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }

    50% {
      transform: translateY(-8px) rotate(0.4deg);
    }
  }


  /* =========================================================
    SEAL LAYER ANIMATIONS
  ========================================================= */

  @property --sweep {
    syntax: "<angle>";
    initial-value: 360deg;
    inherits: false;
  }

  @keyframes sweep {
    from {
      --sweep: 0deg;
    }

    to {
      --sweep: 360deg;
    }
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 0 100% 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes setq {
    from {
      opacity: 0;
      transform: scale(0.58);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes engrave {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: scale(1.04);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }


  /* Individual seal layers */

  @media (prefers-reduced-motion: no-preference) {

    .seal .l-ring {
      mask-image:
        conic-gradient(
          from -90deg,
          #000 var(--sweep),
          #0000 0
        );

      animation:
        sweep
        950ms
        cubic-bezier(0.16, 1, 0.3, 1)
        backwards;
    }

    .seal .l-body {
      animation:
        wipe
        720ms
        650ms
        cubic-bezier(0.16, 1, 0.3, 1)
        backwards;
    }

    .seal .l-q {
      transform-origin: 50% 47%;

      animation:
        setq
        550ms
        cubic-bezier(0.16, 1, 0.3, 1)
        backwards;
    }

    .seal .l-gold {
      animation-delay: 900ms;
    }

    .seal .l-sail {
      animation-delay: 980ms;
    }

    .seal .l-globe {
      animation-delay: 1060ms;
    }

    .seal .l-waves {
      animation-delay: 1140ms;
    }

    .seal .l-stars {
      animation-delay: 1220ms;
    }

    .seal .l-type {
      animation:
        engrave
        800ms
        1400ms
        cubic-bezier(0.16, 1, 0.3, 1)
        backwards;
    }
  }


  /* =========================================================
    FEE / CONTENT BANDS
  ========================================================= */

  .band {
    padding-block: var(--sec);

    position: relative;
  }

  .band--paper {
    background: var(--paper);
    color: var(--ink);
  }

  .band--paper-alt {
    background: var(--paper-2);
    color: var(--ink);

    border-block: 1px solid var(--rule);
  }

  .band--ink {
    background: var(--ink);
    color: var(--paper);

    position: relative;

    overflow: hidden;
  }

  .band--ink::before {
    content: "";

    position: absolute;

    bottom: 0;
    left: 0;

    width: 45%;
    height: 65%;

    background:
      url("../homepage/assets/seal-l6-waves.svg")
      no-repeat
      30% 70% / 320%;

    opacity: 0.08;

    pointer-events: none;
  }

  .band--ink-pattern {
    background: var(--ink);
    color: var(--paper);

    position: relative;

    overflow: hidden;
  }

  .band--ink-pattern::before {
    content: "";

    position: absolute;

    bottom: 0;
    left: 0;

    width: 45%;
    height: 65%;

    background:
      url("../homepage/assets/seal-l6-waves.svg")
      no-repeat
      30% 70% / 320%;

    opacity: 0.08;

    pointer-events: none;
  }

  .band--ink-pattern::after {
    content: "";

    position: absolute;

    top: 0;
    right: 0;

    width: 35%;
    height: 50%;

    background:
      url("../homepage/assets/seal-l7-stars.svg")
      no-repeat
      80% 20% / 240%;

    opacity: 0.07;

    pointer-events: none;
  }

  .band--gold {
    background:
      linear-gradient(
        135deg,
        #E6B509 0%,
        #D8A800 50%,
        #C99D00 100%
      );

    color: var(--ink);
  }


  /* =========================================================
    MISSION / VISION CARDS
  ========================================================= */

  .mv-grid {
    display: grid;

    grid-template-columns:
      repeat(
        auto-fit,
        minmax(min(100%, 23rem), 1fr)
      );

    gap: clamp(1.5rem, 3vw, 2.5rem);

    margin-block-start:
      clamp(2.5rem, 5vw, 3.5rem);
  }

  .mv-card {
    position: relative;

    background: var(--paper-card);

    border: 1px solid var(--rule);

    border-radius: var(--r);

    padding:
      clamp(2rem, 4vw, 3rem);

    box-shadow: var(--shadow-sm);

    display: flex;
    flex-direction: column;

    gap: 1.25rem;

    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;

    cursor: pointer;

    margin-block-end: 1.25rem;
  }

  .mv-card--gold-border {
    border-color: var(--gold);
  }

  .mv-card:hover {
    transform: translateY(-6px);

    box-shadow: var(--shadow-md);

    border-color:
      rgba(64, 0, 104, 0.35);
  }

  .mv-card__tag {
    display: inline-flex;

    align-items: center;

    gap: 0.5rem;

    font-size: 0.72rem;

    font-weight: 600;

    letter-spacing: 0.16em;

    text-transform: uppercase;

    color: var(--purple);
  }

  .mv-card__tag::before {
    content: "";

    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--gold);
  }

  .mv-card h3 {
    font-size:
      clamp(1.4rem, 1.1rem + 1vw, 2rem);

    font-weight: 600;

    line-height: 1.12;

    color: var(--purple);
  }

  .mv-card p {
    font-size: 1.05rem;

    line-height: 1.65;

    color: var(--ink);
  }

  .mv-card__foot {
    margin-block-start: auto;

    padding-block-start: 1rem;

    border-block-start: 1px solid var(--rule);

    display: flex;

    flex-wrap: wrap;

    gap: 0.5rem;
  }


  /* =========================================================
    FEE DROPDOWN
  ========================================================= */

  .fee-dropdown {
    margin-block-start: 1rem;

    border-radius: 8px;

    border: 1px solid var(--rule);

    overflow: hidden;

    background: rgba(255, 255, 255, 0.4);
  }

  .fee-dropdown-toggle {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0.9rem 1.25rem;

    background: transparent;

    border: none;

    cursor: pointer;

    font: inherit;

    font-size: 0.95rem;

    font-weight: 600;

    color: var(--ink);

    width: 100%;

    text-align: left;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .fee-dropdown-toggle:hover {
    background: rgba(64, 0, 104, 0.05);
  }

  .fee-dropdown-toggle::after {
    content: "";

    width: 12px;
    height: 12px;

    border: 2px solid currentColor;

    border-top-color: transparent;
    border-right-color: transparent;

    transform: rotate(-45deg);

    transition:
      transform 0.3s
      cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fee-dropdown[open] .fee-dropdown-toggle::after {
    transform: rotate(135deg);
  }

  .fee-dropdown[open] {
    background: rgba(255, 255, 255, 0.6);

    border-color: var(--purple);

    box-shadow:
      0 8px 24px
      rgba(64, 0, 104, 0.15);
  }

  .fee-dropdown__items {
    padding: 0.25rem;

    border-top:
      1px solid
      rgba(64, 0, 104, 0.15);
  }

  .fee-dropdown-item {
    padding: 0.75rem 1.25rem;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

    transition:
      background 0.2s ease,
      color 0.2s ease;

    font-size: 0.9rem;

    border-radius: 6px;
  }

  .fee-dropdown-item:hover {
    background:
      rgba(64, 0, 104, 0.08);

    color: var(--purple);
  }

  .fee-dropdown-item.is-selected {
    background:
      rgba(64, 0, 104, 0.12);

    color: var(--purple);

    font-weight: 600;
  }

  .fee-dropdown__label {
    flex: 1;
  }

  .fee-dropdown__amount {
    font-family:
      "Plex Serif",
      Georgia,
      serif;

    font-size: 1.15rem;

    font-weight: 600;

    color: var(--purple);

    font-variant-numeric:
      tabular-nums;

    white-space: nowrap;
  }

  .fee-dropdown__chevron {
    width: 14px;
    height: 14px;

    border: 1.5px solid currentColor;

    border-top-color: transparent;
    border-right-color: transparent;

    transform: rotate(-45deg);

    transition:
      transform 0.3s
      cubic-bezier(0.4, 0, 0.2, 1);

    flex: none;
  }

  .fee-dropdown-item.is-selected
  .fee-dropdown__chevron {
    transform: rotate(45deg);

    color: var(--purple);
  }


  /* =========================================================
    COUNTERS
  ========================================================= */

  .counter-wrapper {
    overflow: hidden;
  }

  .counter-wrapper span {
    display: inline-block;

    transition:
      transform 0.6s
      cubic-bezier(0.16, 1, 0.3, 1);
  }

  .counter-wrapper.is-visible span {
    transform: translateY(0);
  }


  /* =========================================================
    STAGGER REVEALS
  ========================================================= */

  @keyframes staggerSlide {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .stagger-reveal {
    opacity: 0;

    animation:
      staggerSlide
      0.5s
      cubic-bezier(0.16, 1, 0.3, 1)
      forwards;
  }

  .stagger-reveal-1 {
    animation-delay: 0s;
  }

  .stagger-reveal-2 {
    animation-delay: 0.1s;
  }

  .stagger-reveal-3 {
    animation-delay: 0.2s;
  }

  .stagger-reveal-4 {
    animation-delay: 0.3s;
  }

  .stagger-reveal-5 {
    animation-delay: 0.4s;
  }


  /* =========================================================
    SCROLL REVEALS
  ========================================================= */

  .reveal-on-scroll {
    opacity: 0;

    transform: translateY(22px);

    transition:
      opacity 0.65s
      cubic-bezier(0.16, 1, 0.3, 1),

      transform 0.65s
      cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;

    transform: none;
  }


  /* =========================================================
    TABLET
  ========================================================= */

  @media (max-width: 64rem) {

    /* Mobile navigation */

    .menu {
      display: none;
    }

    .burger {
      display: block;
    }

    .menu.is-open {
      display: block;

      position: absolute;

      top: 100%;
      left: 0;
      right: 0;

      background: #17061F;

      padding: 0.5rem 0;

      padding-inline:
        calc(var(--gutter) - 0.85rem);

      border-top:
        1px solid
        rgba(243, 238, 228, 0.2);

      z-index: 65;

      max-height: 70vh;

      overflow-y: auto;
    }

    .menu.is-open .sub {
      position: static;

      opacity: 1;
      visibility: visible;

      transform: none;

      box-shadow: none;

      background: transparent;

      color: var(--muted-ink);

      border-radius: 0;

      padding: 0 0 0.5rem;
    }

    .menu.is-open .sub a {
      padding-inline:
        calc(var(--gutter) + 0.15rem);

      color: var(--muted-ink);
    }

    .menu.is-open .sub a:hover {
      background: transparent;

      color: var(--gold);
    }


    /* Hero */

    .hero__in {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

      min-height: 540px;
    }

    .seal-stage {
      transform: translateX(5vw);
    }

    .seal {
      max-width: 330px;
    }
  }


  /* =========================================================
    MOBILE
  ========================================================= */

  @media (max-width: 58rem) {

    .hero__in {
      display: grid;

      grid-template-columns: 1fr;

      min-height: auto;

      gap: 3rem;

      padding-block:
        4rem
        5rem;
    }


    /* Text first */

    .hero__copy {
      order: 1;

      max-width: 650px;

      margin-inline: auto;

      text-align: center;
    }

    .hero__status {
      justify-content: center;
    }

    .hero__sub {
      margin-inline: auto;
    }

    .hero__cta {
      justify-content: center;
    }


    /* Logo underneath */

    .seal-stage {
      order: 2;

      transform: none;

      animation:
        seal-sweep-mobile
        1s
        cubic-bezier(0.16, 1, 0.3, 1)
        0.1s
        backwards;
    }

    .seal {
      max-width: 260px;
    }


    /* Disable horizontal text movement on small screens */

    .hero__copy {
      animation-name: heroTextMobile;
    }

    @keyframes heroTextMobile {

      from {
        opacity: 0;
        transform: translateY(25px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }

    }

    @keyframes seal-sweep-mobile {

      from {
        opacity: 0;
        transform: translateY(25px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }

    }
  }


  /* =========================================================
    SMALL PHONES
  ========================================================= */

  @media (max-width: 35rem) {

    .bar__in {
      padding-block: 0.7rem;
    }

    .brand img {
      width: 1.8rem;
    }

    .brand b {
      font-size: 0.9rem;
    }

    .brand span {
      font-size: 0.55rem;
    }

    .bar__cta .btn {
      display: none;
    }

    .hero__in {
      padding-block:
        3.5rem
        4rem;
    }

    .hero__copy h1 {
      font-size:
        clamp(2.2rem, 12vw, 3.5rem);
    }

    .hero__sub {
      font-size: 1rem;
    }

    .seal {
      max-width: 230px;
    }
  }


  /* =========================================================
    REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;

      animation-delay: 0ms !important;

      transition-duration: 0.01ms !important;

      scroll-behavior: auto !important;
    }

    .hero__copy,
    .reveal-on-scroll {
      opacity: 1 !important;

      transform: none !important;
    }

    .seal-stage {
      transform: none !important;

      animation: none !important;
    }

    }
    .mv-card > div {
    align-items: stretch;
    }

    .mv-card > div > div:first-child,
    .mv-card > div > div:last-child {
      margin-top: 0 !important;
    }

    .mv-card > div > div:last-child {
      padding-top: 0 !important;
    }

    .mv-card > div > div:first-child .eyebrow,
    .mv-card > div > div:last-child .eyebrow {
      height: 2rem;
      display: flex;
      align-items: center;
      margin-bottom: 1rem !important;
    }

    #feeNav .btn.is-active {
      background: var(--gold);
      color: var(--ink);
      border-color: var(--gold);
      font-weight: 600;
      box-shadow: 0 8px 25px var(--gold-glow);
    }

    #feeNav .btn.is-active:hover {
      background: var(--gold-lift);
    }
  </style>
</head>

